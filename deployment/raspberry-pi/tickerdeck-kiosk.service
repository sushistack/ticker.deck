# Installed as a user unit: `systemctl --user enable --now tickerdeck-kiosk`.
#
# default.target, NOT graphical-session.target: on Raspberry Pi OS (Trixie, labwc
# session via lightdm autologin) graphical-session.target is never activated in the
# systemd user manager -- `systemctl --user is-active graphical-session.target`
# reports `inactive` on a fully working kiosk -- so a unit wanted by it never starts.
# Restart=always covers the resulting race where this unit is reached before the
# compositor is up.
[Unit]
Description=TickerDeck Chromium kiosk
After=default.target network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/.config/tickerdeck-kiosk.env
ExecStartPre=/bin/sh -c 'until /usr/bin/curl -fsS "$TICKERDECK_URL/healthz" >/dev/null; do sleep 5; done'
ExecStart=/usr/bin/chromium --kiosk --ozone-platform=wayland --password-store=basic --disable-features=Translate --no-first-run --noerrdialogs --disable-session-crashed-bubble --disable-pinch --overscroll-history-navigation=0 ${TICKERDECK_URL}
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
